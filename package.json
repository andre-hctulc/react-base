{
    "name": "@dre44/react-base",
    "version": "0.12.0",
    "main": "dist/index.js",
    "type": "module",
    "repository": "https://github.com/andre-hctulc/react-base.git",
    "scripts": {
        "build:registry": "./node_modules/.bin/shadcn build",
        "tc": "tsc --noEmit -p tsconfig.build.json",
        "tc:watch": "tsc --watch --noEmit -p tsconfig.build.json",
        "prebuild": "rm -rf dist && tsc --noEmit",
        "build": "npm run build:ts && npm run build:registry",
        "build:ts": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "lint": "npx eslint src",
        "demo": "npx serve -s ./demo-build -p 3065",
        "demo:prepare": "node --loader ts-node/esm scripts/build-comp-demos.ts",
        "create-safelist": "tsx scripts/safelist-gen.ts",
        "storybook": "storybook dev -p 6006",
        "storybook:build": "storybook build",
        "storybook:tc": "tsc --noEmit"
    },
    "exports": {
        ".": "./dist/index.js",
        "./hooks": "./dist/hooks/index.js",
        "./types": "./dist/types/index.js",
        "./util": "./dist/util/index.js",
        "./components": "./dist/components/index.js"
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dot-prop": "^9.0.0",
        "lucide-react": "^1.28.0"
    },
    "peerDependencies": {
        "react": "^19",
        "react-dom": "^19"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^3.2.6",
        "@eslint/eslintrc": "^3",
        "@storybook/addon-essentials": "^8.6.7",
        "@storybook/addon-onboarding": "^8.6.7",
        "@storybook/blocks": "^8.6.7",
        "@storybook/experimental-addon-test": "^8.6.7",
        "@storybook/react": "^8.6.7",
        "@storybook/react-vite": "^8.6.7",
        "@storybook/test": "^8.6.7",
        "@tailwindcss/postcss": "^4",
        "@tailwindcss/vite": "^4.0.14",
        "@types/node": "^20.19.43",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitest/browser": "^3.0.9",
        "@vitest/coverage-v8": "^3.0.9",
        "copyfiles": "^2.4.1",
        "eslint": "^9",
        "eslint-plugin-storybook": "^0.11.6",
        "playwright": "^1.51.1",
        "storybook": "^8.6.7",
        "tailwindcss": "^4",
        "tsc-alias": "^1.9.1",
        "typescript": "^5",
        "vite": "^6.3.5",
        "vitest": "^3.0.9",
        "shadcn": "^4.16.0",
        "tw-animate-css": "^1.4.0",
        "@base-ui/react": "^1.6.0",
        "@shadcn/react": "^0.2.1",
        "@hookform/resolvers": "^5.7.1",
        "@radix-ui/react-accordion": "^1.2.20",
        "@radix-ui/react-alert-dialog": "^1.1.23",
        "@radix-ui/react-aspect-ratio": "^1.1.15",
        "@radix-ui/react-checkbox": "^1.3.11",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slot": "^1.3.3",
        "radix-ui": "^1.6.7",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.4.2",
        "next-themes": "^0.4.6",
        "react-day-picker": "^10.0.1",
        "react-hook-form": "^7.84.0",
        "react-resizable-panels": "^4.12.2",
