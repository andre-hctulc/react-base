{
    "name": "@dre44/react-base",
    "version": "0.13.0",
    "private": true,
    "main": "dist/index.js",
    "type": "module",
    "packageManager": "pnpm@11.13.1",
    "repository": "https://github.com/andre-hctulc/react-base.git",
    "scripts": {
        "build:registry": "./node_modules/.bin/shadcn build",
        "tc": "tsc --noEmit -p tsconfig.build.json",
        "tc:watch": "tsc --watch --noEmit -p tsconfig.build.json",
        "prebuild": "rm -rf dist",
        "build": "npm run build:ts && npm run build:registry",
        "prepack": "npm run build",
        "build:ts": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "lint": "npx eslint src",
        "demo": "npx serve -s ./demo-build -p 3065",
        "demo:prepare": "node --loader ts-node/esm scripts/build-comp-demos.ts",
        "theme:css": "node scripts/build-registry-theme-css.mjs",
        "storybook": "pnpm theme:css && storybook dev -p 6006",
        "storybook:build": "pnpm theme:css && storybook build",
        "storybook:tc": "tsc --noEmit"
    },
    "exports": {
        ".": "./dist/index.js",
        "./hooks": "./dist/hooks/index.js",
        "./types": "./dist/types/index.js",
        "./util": "./dist/util/index.js",
        "./components": "./dist/components/index.js"
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1"
    },
    "devDependencies": {
        "@base-ui/react": "^1.6.0",
        "@chromatic-com/storybook": "^3.2.6",
        "@dre44/form-data-parser": "^0.2.0",
        "@eslint/eslintrc": "^3",
        "@hookform/resolvers": "^5.7.1",
        "@rjsf/core": "^6.7.1",
        "@rjsf/utils": "^6.7.1",
        "@rjsf/validator-ajv8": "^6.7.1",
        "@shadcn/react": "^0.3.0",
        "@storybook/addon-essentials": "^8.6.14",
        "@storybook/addon-onboarding": "^10.5.10",
        "@storybook/addon-vitest": "^10.5.10",
        "@storybook/blocks": "^8.6.14",
        "@storybook/react": "^10.5.10",
        "@storybook/react-vite": "^10.5.10",
        "@storybook/test": "^8.6.15",
        "@tailwindcss/postcss": "^4",
        "@tailwindcss/vite": "^4.0.14",
        "@tanstack/react-table": "^9.0.0",
        "@types/node": "^24",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19",
        "@vitest/browser": "^4.1.11",
        "@vitest/browser-playwright": "^4.1.11",
        "@vitest/coverage-v8": "^4.1.11",
        "cmdk": "^1.1.1",
        "copyfiles": "^2.4.1",
        "date-fns": "^4.4.0",
        "dot-prop": "^9.0.0",
        "embla-carousel-react": "^8.6.0",
        "eslint": "^10",
        "eslint-plugin-storybook": "^0.11.6",
        "input-otp": "^1.4.2",
        "lucide-react": "^1.28.0",
        "next-themes": "^0.4.6",
        "playwright": "^1.51.1",
        "radix-ui": "^1.6.7",
        "react": "^19",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19",
        "react-hook-form": "^7.84.0",
        "react-resizable-panels": "^4.12.2",
        "recharts": "^3.8.0",
        "shadcn": "^4.16.0",
        "sonner": "^2.0.7",
        "storybook": "^10.5.10",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4",
        "tsc-alias": "^1.9.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5",
        "vaul": "^1.1.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "zod": "^3.25.76"
    }
}
