{
    "name": "@dre44/react-base",
    "version": "0.12.0",
    "main": "dist/index.js",
    "type": "module",
    "repository": "https://github.com/andre-hctulc/react-base.git",
    "scripts": {
        "tc": "tsc --noEmit -p tsconfig.build.json",
        "tc:watch": "tsc --watch --noEmit -p tsconfig.build.json",
        "prebuild": "rm -rf dist",
        "build": "npm run build:ts && npm run build:css && npm run build:exports",
        "build:ts": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "build:css": "copyfiles -u 1 src/**/*.css dist/",
        "build:exports": "tsx scripts/make-exports.ts",
        "lint": "npx eslint src",
        "demo": "npx serve -s ./demo-build -p 3065",
        "demo:prepare": "node --loader ts-node/esm scripts/build-comp-demos.ts",
        "create-safelist": "tsx scripts/safelist-gen.ts",
        "storybook": "storybook dev -p 6006",
        "storybook:build": "storybook build",
        "storybook:tc": "tsc --noEmit"
    },
    "exports": {
        ".": "./dist/index.js",
        "./hooks": "./dist/hooks/index.js",
        "./types": "./dist/types/index.js",
        "./util": "./dist/util/index.js",
        "./cn/alert": "./dist/components/cn/alert.js",
        "./cn/badge": "./dist/components/cn/badge.js",
        "./cn/button": "./dist/components/cn/button.js",
        "./cn/checkbox": "./dist/components/cn/checkbox.js",
        "./cn/dialog": "./dist/components/cn/dialog.js",
        "./cn/input": "./dist/components/cn/input.js",
        "./cn/label": "./dist/components/cn/label.js",
        "./cn/select": "./dist/components/cn/select.js",
        "./cn/textarea": "./dist/components/cn/textarea.js",
        "./components/alert": "./dist/components/alert/index.js",
        "./components/containers": "./dist/components/containers/index.js",
        "./components/data-display": "./dist/components/data-display/index.js",
        "./components/dev": "./dist/components/dev/index.js",
        "./components/dialog": "./dist/components/dialog/index.js",
        "./components/exotic": "./dist/components/exotic/index.js",
        "./components/icons": "./dist/components/icons/index.js",
        "./components/input": "./dist/components/input/index.js",
        "./components/label": "./dist/components/label/index.js",
        "./components/layout": "./dist/components/layout/index.js",
        "./components/navigation": "./dist/components/navigation/index.js",
        "./components/shadow": "./dist/components/shadow/index.js",
        "./components/stat": "./dist/components/stat/index.js",
        "./components/text": "./dist/components/text/index.js",
        "./components/transitions": "./dist/components/transitions/index.js"
    },
    "dependencies": {
        "@dre44/util": "^0.27.0",
        "@radix-ui/react-checkbox": "^1.3.11",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-slot": "^1.3.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dot-prop": "^9.0.0",
        "lucide-react": "^1.28.0",
        "react-icons": "^5.7.0",
        "shadcn": "^4.16.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "peerDependencies": {
        "react": "^19",
        "react-dom": "^19"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^3.2.6",
        "@eslint/eslintrc": "^3",
        "@storybook/addon-essentials": "^8.6.7",
        "@storybook/addon-onboarding": "^8.6.7",
        "@storybook/blocks": "^8.6.7",
        "@storybook/experimental-addon-test": "^8.6.7",
        "@storybook/react": "^8.6.7",
        "@storybook/react-vite": "^8.6.7",
        "@storybook/test": "^8.6.7",
        "@tailwindcss/postcss": "^4",
        "@tailwindcss/vite": "^4.0.14",
        "@types/node": "^20.19.43",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitest/browser": "^3.0.9",
        "@vitest/coverage-v8": "^3.0.9",
        "copyfiles": "^2.4.1",
        "eslint": "^9",
        "eslint-plugin-storybook": "^0.11.6",
        "playwright": "^1.51.1",
        "storybook": "^8.6.7",
        "tailwindcss": "^4",
        "tsc-alias": "^1.9.1",
        "typescript": "^5",
        "vite": "^6.3.5",
        "vitest": "^3.0.9"
    }
}